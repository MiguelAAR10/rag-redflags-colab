# LLMs / proveedores
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Gemini (F16 web: LLM por API)
GOOGLE_API_KEY=

# Hugging Face (embeddings F3, reranker F5, Qwen F6). Leer desde el entorno, nunca hardcodear.
HF_TOKEN=
HUGGINGFACE_TOKEN=

# F16 web demo (multiagent-ready MVP)
DATABASE_URL=sqlite:///./data/tdr_review.db
UPLOAD_DIR=./data/uploads
RAG_USE_GOOGLE_LLM=1
RAG_GEMINI_MODEL=gemini-2.5-flash
RAG_QWEN_4BIT=0
RAG_EMBEDDINGS_BACKEND=cpu-e5

# V2: base de datos vectorial (Qdrant Cloud free tier)
# Crear cluster en https://cloud.qdrant.io y pegar aquí (nunca hardcodear)
# (también se acepta QDRANT_ENDPOINT como alias de QDRANT_URL)
QDRANT_URL=
QDRANT_API_KEY=

# V2 F18: backend de retrieval y grounding de la web
# faiss (local, default para tests) | qdrant (producción, standard_kb)
RAG_VECTOR_STORE=faiss
# lexical (determinista) | gemini (semántico multilingüe, producción)
RAG_GROUNDING_METHOD=lexical
GROUNDING_THRESHOLD_SEMANTIC=0.72

# V2: Vertex AI (alternativa a la API key; factura al proyecto GCP vía ADC)
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Opcionales (no usados en el MVP Colab/FAISS)
VECTOR_STORE_URL=
# F19: indexar documentos subidos en subject_docs (Qdrant) con diff incremental
RAG_INDEX_SUBJECT_DOCS=0
